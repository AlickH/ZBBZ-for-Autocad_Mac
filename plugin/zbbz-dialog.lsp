(defun zbbz-dialog-handle-apply-base-angle (/ base_n base_e rotation)
  (setq base_n (distof (get_tile "base_n") 2))
  (setq base_e (distof (get_tile "base_e") 2))
  (setq rotation (distof (get_tile "rotation") 2))
