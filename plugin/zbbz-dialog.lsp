    (progn
      (zbbz-dialog-put-many
        (list
          (cons 'coord_mode 'custom)
          (cons 'base_n base_n)
          (cons 'base_e base_e)
          (cons 'rotation rotation)))
      (zbbz-dialog-populate))))

