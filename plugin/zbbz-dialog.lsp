(defun zbbz-dialog-sorted-translation-pairs ()
  (vl-sort
    (zbbz-dialog-translation-pairs)
    '(lambda (left right)
       (> (strlen (car left)) (strlen (car right))))))

(defun zbbz-dialog-localize-line (line)
  (foreach pair (zbbz-dialog-sorted-translation-pairs)
    (setq line (vl-string-subst (cdr pair) (car pair) line)))
  line)

